///|
test "rfc9420 treekem.json vec_0 cs1" {
  let cs = cs_from_u16(1U)
  let group_id = hex(
    "476813a66a9e9a464c40e79f4f8449d939d9235c56ea955ba7e230ec6d7f6b03",
  )
  let epoch = 28061UL
  let cth = hex(
    "7977581cbf08ae1819408f7c1feb8c8c0833fe6d68468f278b1902cff981dbb5",
  )
  let raw_nodes = @types.ratchet_tree_from_bytes(
    hex(
      "",
    ),
  )
  let base_tree = @tree.RatchetTreeState::from_nodes(raw_nodes)
  base_tree.validate_tree_structure()
  base_tree.validate_parent_hashes(cs)
  base_tree.validate_leaf_signatures(cs, group_id)
  let leaves_priv : Array[(UInt32, String, Array[(UInt32, String)])] = [
    (
      0U,
      "7957e5368bbfe5dcfcce0cac8868d3d1943d7733f5c77ef582ee84ab6a281176",
      [(1U, "8313fdeaeb49196b0e35e38c37c9efcc1014380332a8c4c0783b13a4bc059f3b")],
    ),
    (
      1U,
      "2a7ab9e8c1a8077944fa0f59303faf1d7da5ec43c7a3f345910c87478d12c202",
      [(1U, "8313fdeaeb49196b0e35e38c37c9efcc1014380332a8c4c0783b13a4bc059f3b")],
    ),
  ]
  let update_paths : Array[(UInt32, String, String, String)] = [
    (
      0U, "",
      "e90f531363f40f04a0e5207e4fcdad46fb9398ca2c208eee1c198ea3e73876c5", "5ccc25c82569cc9731283abbdb9265187c17503e6f9c4ba2484a9e210e83f5a3",
    ),
    (
      1U, "",
      "ad926d28a9ceaa99e24f66d289098f87d52965f7c903804a833cfa0dfc0d711c", "4179fbbca043d7139726430d976a623eac87a9d18bfee7227f2c4d54c16d041e",
    ),
  ]
  for u = 0; u < update_paths.length(); u = u + 1 {
    let (sender, up_hex, expected_th_hex, expected_cs_hex) = update_paths[u]
    let tree = base_tree.clone()
    let up = @types.UpdatePath::from_bytes(hex(up_hex))
    tree.merge_update_path_nodes(cs, sender, up, group_id, [])
    let th_after = tree.tree_hash(cs)
    assert_eq(th_after, hex(expected_th_hex))
    tree.validate_parent_hashes(cs)
    let gc : @types.GroupContext = {
      version: @types.PROTOCOL_VERSION_MLS10,
      cipher_suite: cs.id(),
      group_id,
      epoch,
      tree_hash: th_after,
      confirmed_transcript_hash: cth,
      extensions: [],
    }
    let gc_bytes = gc.to_bytes()
    for lp_i = 0; lp_i < leaves_priv.length(); lp_i = lp_i + 1 {
      let (my_leaf, enc_priv_hex, ps_list) = leaves_priv[lp_i]
      if my_leaf == sender {
        continue
      }
      let priv_map : Map[UInt32, Bytes] = Map([])
      priv_map.set(@treemath.leaf_to_node(my_leaf), hex(enc_priv_hex))
      for p_i = 0; p_i < ps_list.length(); p_i = p_i + 1 {
        let (node_idx, ps_hex) = ps_list[p_i]
        let node_sec = cs.derive_secret(hex(ps_hex), "node")
        let (sk, _pk) = cs.kem_keypair_from_ikm(node_sec)
        priv_map.set(node_idx, sk)
      }
      let (_keys, commit_secret) = tree.decrypt_update_path(
        cs,
        sender,
        my_leaf,
        up,
        gc_bytes,
        [],
        fn(n) { priv_map.get(n) },
      )
      assert_eq(commit_secret, hex(expected_cs_hex))
    }
  }
}

