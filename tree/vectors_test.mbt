      "9d979b762eac328e6f29f749",
    ),
  ]
  for i = 0; i < leaves.length(); i = i + 1 {
    let (leaf_idx, gen, hk, hn, ak, an) = leaves[i]
    let (got_hk, got_hn) = st.handshake_key_nonce_for_generation(leaf_idx, gen)
    assert_eq(got_hk, hex(hk))
    assert_eq(got_hn, hex(hn))
    let (got_ak, got_an) = st.application_key_nonce_for_generation(
      leaf_idx, gen,
    )
    assert_eq(got_ak, hex(ak))
    assert_eq(got_an, hex(an))
  }
}

///|
test "rfc9420 tree-validation.json vec_0 cs1 nodes=3" {
  let cs = cs_from_u16(1U)
  let group_id = hex(
    "99eb8e58d827942e1d519c80de6861e96e365f0c9f4c01bb12daed4a29ae31a9",
  )
  let raw_nodes = @types.ratchet_tree_from_bytes(
    hex(
      "",
    ),
  )
  let tree = @tree.RatchetTreeState::from_nodes(raw_nodes)
  assert_eq(tree.n_nodes(), 3U)
  tree.validate_tree_structure()
  tree.validate_parent_hashes(cs)
  tree.validate_leaf_signatures(cs, group_id)
  let expected_hashes : Array[String] = [
    "6f9e6f4986032c65ab08dbdc329fa2e8ee4e069a5ffd148f8c8baa30108a4e13", "b30fe5a7fce94e0d267f3f8d3e1628c695587370833efcd11584b32978c23dd2",
    "135d5ae4cd847ad243ad9714213de9839785b3a48d0cb34e8aed817d49bff678",
  ]
  let expected_res : Array[Array[UInt32]] = [[0U], [1U], [2U]]
  for i = 0; i < expected_hashes.length(); i = i + 1 {
    let node_idx = i.reinterpret_as_uint()
    assert_eq(tree.node_hash(cs, node_idx), hex(expected_hashes[i]))
    assert_eq(tree.resolution(node_idx), expected_res[i])
  }
}

///|
test "rfc9420 tree-validation.json vec_1 cs1 nodes=7" {
  let cs = cs_from_u16(1U)
  let group_id = hex(
