///|
fn hex(s : String) -> Bytes raise {
  @tls.bytes_from_hex(s)
}

///|
fn cs_from_u16(id : UInt32) -> @cs.CipherSuite raise {
  @cs.CipherSuite::from_id(id)
}

///|
test "rfc9420 tree-operations.json all 5 vectors" {
  let cases : Array[(UInt32, String, UInt32, String, String, String, String)] = [
    (
      1U, "",
      0U, "",
      "cf16040ad8680a387d870c26b5688a9f353c665320666aa1a55625f3f9b36224", "",
      "af8003e98d618669d2563f46607beb4536467bea9938e826ed8b11b0316ab680",
    ),
    (
      1U, "",
      0U, "",
      "e784f949fc040860c7a5648e6cecb2c7d2249e8f746f55f542d91ad7c3a6adf8", "",
      "35401ab19294389951a3858988952aa4c0baa3f29cc66a9207e9485d7def5a85",
    ),
    (
      1U, "",
      3U, "",
      "c6a17498a4632bbab8606da2af5216103fc76a516923e816334a57a8633f47fa", "",
      "76b3dc5edee2a0ae88bb1f5934b9ab8bc67eec912d92520f61381fb1dfb51adb",
    ),
    (
      1U, "",
      0U, "000300000008", "c22cab9734182a792fb3f942469a326028280b9bd9a963a69ad1bc15b54cccce",
      "",
      "e07ec23bef84f9695cab0b5f1f05770943b2fb79522c4fff45fcbce5f6c160e1",
    ),
    (
      1U, "",
      0U, "000300000004", "853e970c82285a8abd7613d1f9bbfe1f30ca9e5c14d1bff58ce77bbe93ba04ac",
      "",
      "fcd5be02ba0e934651c0eb9fdb1c999fc3e42673fcf0c8bec062036461fb52f3",
    ),
  ]
  for i = 0; i < cases.length(); i = i + 1 {
    let (
      cs_id,
      tree_before_hex,
      sender,
      prop_hex,
      hash_before_hex,
      tree_after_hex,
      hash_after_hex,
    ) = cases[i]
    let cs = cs_from_u16(cs_id)
    let nodes_before = @types.ratchet_tree_from_bytes(hex(tree_before_hex))
    let tree = @tree.RatchetTreeState::from_nodes(nodes_before)
    assert_eq(tree.tree_hash(cs), hex(hash_before_hex))
    let proposal = @types.Proposal::from_bytes(hex(prop_hex))
    let _ = tree.apply_proposal(sender, proposal)
    let encoded_after = @types.ratchet_tree_to_bytes(tree.to_trimmed_nodes())
    assert_eq(encoded_after, hex(tree_after_hex))
    assert_eq(tree.tree_hash(cs), hex(hash_after_hex))
  }
}

///|
test "rfc9420 secret-tree.json vec_0 cs1 n_leaves=1" {
  let cs = cs_from_u16(1U)
  let sd_secret = hex(
    "95684b805e1bbd9c71d1abaf8a1930c12112b9a06c12db937970be5bbb916573",
  )
  let sd_ct = hex(
    "156f2eb3fa482cff20e3a090c267ce6481d4a0976aee2adb921d70ae8a04a6494339462ac049f185e7184d8245270e54e68b72bd5df66800367c50e423cafec0260ac4dc743c24cabfc6060fc5",
  )
  assert_eq(
    @tree.derive_sender_data_key(cs, sd_secret, sd_ct),
    hex("92667d9c889a6b768c157538c0a79fed"),
  )
  assert_eq(
    @tree.derive_sender_data_nonce(cs, sd_secret, sd_ct),
    hex("362785b1cc8bc775fcc216e7"),
  )
  let enc_secret = hex(
    "d69fcc35969e94680461974bd26c7cda7594cbf45985c4bf668c3b3118b765ab",
  )
  let st = @tree.SecretTree::new(cs, enc_secret, 1U)
  let leaves : Array[(UInt32, UInt32, String, String, String, String)] = [
    (
      0U, 0U, "a2d6b8a9255478e9b79a076872ae3563", "8e8fc08a4eb5189b7b558527", "442e691710646617a21e41482d868a4e",
      "c76e37884536a9ce33fb3070",
    ),
    (
      0U, 15U, "6121c93d8e92e76320087e5d646a3bf2", "961e5b73d62b72743b900c88", "0f2d1b9e1d5c09abefb0edabd8349e9f",
      "a08d3a0243b6216cc92671ec",
    ),
  ]
  for i = 0; i < leaves.length(); i = i + 1 {
    let (leaf_idx, gen, hk, hn, ak, an) = leaves[i]
    let (got_hk, got_hn) = st.handshake_key_nonce_for_generation(leaf_idx, gen)
    assert_eq(got_hk, hex(hk))
    assert_eq(got_hn, hex(hn))
    let (got_ak, got_an) = st.application_key_nonce_for_generation(
      leaf_idx, gen,
    )
    assert_eq(got_ak, hex(ak))
    assert_eq(got_an, hex(an))
  }
}

