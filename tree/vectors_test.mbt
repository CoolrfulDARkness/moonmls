///|
test "rfc9420 secret-tree.json vec_6 cs3 n_leaves=1" {
  let cs = cs_from_u16(3U)
  let sd_secret = hex(
    "d61204c27f29de53d30ff54a6ebb53e9908d044f55b9e726fa5736d4246b7b36",
  )
  let sd_ct = hex(
    "d0f75d5b691dbff35cafe226adad83aa5076c85035fef7d7fac489ad63f10828266b44ea366961509e8c9c24474abb6066c5a350aeb2b05415facb7ac2aa1b1efcf75a0c700bfdc93c705e352c",
  )
  assert_eq(
    @tree.derive_sender_data_key(cs, sd_secret, sd_ct),
    hex("674a0c3e1500d068aae5d50f57a14648a63de2c246f8178382a150df8031f4cf"),
  )
  assert_eq(
    @tree.derive_sender_data_nonce(cs, sd_secret, sd_ct),
    hex("56b73cca00eac6cc5080be8d"),
  )
  let enc_secret = hex(
    "59227ed552e4a6db0779d43aea694fd1b2c2540e605a099b95cf852b41e8ea66",
  )
  let st = @tree.SecretTree::new(cs, enc_secret, 1U)
  let leaves : Array[(UInt32, UInt32, String, String, String, String)] = [
    (
      0U, 0U, "2ef3c21ad150b59cc78b21bd96e5dc0bd2579e19c7a46b7581fb1969103389d2",
      "5794013a45e0563de4d35ce0", "3f57aae38cbe6eaf31e4c05bd4a6aeba50c6878fa6fc2443bb8f3e57870fe712",
      "4b2599c99b38c18775c85008",
    ),
    (
      0U, 15U, "488400e9d1a4a1d48e94da89dbc6c306d6479004e26aaade4101dd2fd86f2c21",
      "424c2809d87242ecbb1da91f", "bd44b39e16d4d59750469719cd330e4a52ecf5a1c9060254fac3e8ef73f4cf9b",
      "82f8881240b93d1611b34e8c",
    ),
  ]
  for i = 0; i < leaves.length(); i = i + 1 {
    let (leaf_idx, gen, hk, hn, ak, an) = leaves[i]
    let (got_hk, got_hn) = st.handshake_key_nonce_for_generation(leaf_idx, gen)
    assert_eq(got_hk, hex(hk))
    assert_eq(got_hn, hex(hn))
    let (got_ak, got_an) = st.application_key_nonce_for_generation(
      leaf_idx, gen,
    )
    assert_eq(got_ak, hex(ak))
    assert_eq(got_an, hex(an))
  }
}

