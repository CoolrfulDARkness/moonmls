pub fn WireFormat::decode(@tls.Reader) -> Self raise @tls.TlsError
pub fn WireFormat::encode(Self, @tls.Writer) -> Unit
pub fn WireFormat::from_bytes(Bytes) -> Self raise @tls.TlsError
pub fn WireFormat::from_u16(UInt32) -> Self raise @tls.TlsError
pub fn WireFormat::to_bytes(Self) -> Bytes
pub fn WireFormat::to_u16(Self) -> UInt32

// Type aliases
pub type CipherSuiteId = UInt32

pub type RatchetTree = Array[Node?]

