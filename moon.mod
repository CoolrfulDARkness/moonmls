name = "CoolrfulDARkness/moonmls"

version = "0.1.0"

readme = "README.mbt.md"

repository = "https://github.com/CoolrfulDARkness/moonmls"

license = "Apache-2.0"

keywords = ["mls", "rfc9420", "hpke", "rfc9180", "e2ee", "cryptography", "sans-io", "security"]

preferred_target = "wasm-gc"

description = "Pure MoonBit, zero-FFI, Sans-I/O implementation of IETF RFC 9420 Messaging Layer Security (MLS) with RFC 9180 HPKE."
