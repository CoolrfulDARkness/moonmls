///|
priv struct TreeMathVector {
  n_leaves : UInt32
  n_nodes : UInt32
  root : UInt32
  left : Array[Int32]
  right : Array[Int32]
  parent : Array[Int32]
  sibling : Array[Int32]
}

///|
fn expected_opt(v : Int32) -> UInt32? {
  if v < 0 {
    None
  } else {
    Some(v.reinterpret_as_uint())
  }
}

///|
fn verify_vector(vec : TreeMathVector) -> Unit raise {
  assert_eq(@treemath.node_width(vec.n_leaves), vec.n_nodes)
  assert_eq(@treemath.leaf_count(vec.n_nodes), vec.n_leaves)
  assert_eq(@treemath.root(vec.n_leaves), vec.root)
  assert_eq(vec.left.length().reinterpret_as_uint(), vec.n_nodes)
  assert_eq(vec.right.length().reinterpret_as_uint(), vec.n_nodes)
  assert_eq(vec.parent.length().reinterpret_as_uint(), vec.n_nodes)
  assert_eq(vec.sibling.length().reinterpret_as_uint(), vec.n_nodes)
  for i = 0; i < vec.n_nodes.reinterpret_as_int(); i = i + 1 {
    let x = i.reinterpret_as_uint()
    assert_eq(@treemath.left(x), expected_opt(vec.left[i]))
    assert_eq(@treemath.right(x), expected_opt(vec.right[i]))
    assert_eq(@treemath.parent(x, vec.n_leaves), expected_opt(vec.parent[i]))
    assert_eq(@treemath.sibling(x, vec.n_leaves), expected_opt(vec.sibling[i]))

    // Verify leaf / internal classification and leaf <-> node roundtrip
    if @treemath.is_leaf(x) {
      assert_eq(@treemath.level(x), 0U)
      let leaf_idx = match @treemath.node_to_leaf(x) {
        Some(l) => l
        None => fail("expected leaf index")
      }
      assert_eq(@treemath.leaf_to_node(leaf_idx), x)
      assert_eq(@treemath.subtree_range(x), (leaf_idx, leaf_idx))
    } else {
      assert_true(@treemath.level(x) > 0U)
      assert_eq(@treemath.node_to_leaf(x), None)
    }

    // Verify direct_path and copath consistency with parent/sibling arrays
    let dp = @treemath.direct_path(x, vec.n_leaves)
    let cp = @treemath.copath(x, vec.n_leaves)
    assert_eq(dp.length(), cp.length())
    if x == vec.root {
      assert_eq(dp.length(), 0)
    } else {
      assert_true(dp.length() > 0)
      assert_eq(dp[dp.length() - 1], vec.root)
      let mut cur = x
      for step = 0; step < dp.length(); step = step + 1 {
        let exp_p = expected_opt(vec.parent[cur.reinterpret_as_int()])
        let exp_s = expected_opt(vec.sibling[cur.reinterpret_as_int()])
        assert_eq(Some(dp[step]), exp_p)
        assert_eq(Some(cp[step]), exp_s)
        assert_eq(@treemath.parent(cp[step], vec.n_leaves), Some(dp[step]))
        cur = dp[step]
      }
    }
  }
}

///|
test "RFC 9420 tree-math.json vector #1 (n_leaves=1)" {
  let vec : TreeMathVector = {
    n_leaves: 1U,
    n_nodes: 1U,
    root: 0U,
    left: [-1],
    right: [-1],
    parent: [-1],
    sibling: [-1],
  }
  verify_vector(vec)
}

///|
test "RFC 9420 tree-math.json vector #2 (n_leaves=2)" {
  let vec : TreeMathVector = {
    n_leaves: 2U,
    n_nodes: 3U,
    root: 1U,
    left: [-1, 0, -1],
    right: [-1, 2, -1],
    parent: [1, -1, 1],
    sibling: [2, -1, 0],
  }
  verify_vector(vec)
}

