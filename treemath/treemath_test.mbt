///|
test "log2 and level edge cases" {
  assert_eq(@treemath.log2(0U), 0U)
  assert_eq(@treemath.log2(1U), 0U)
  assert_eq(@treemath.log2(2U), 1U)
  assert_eq(@treemath.log2(3U), 1U)
  assert_eq(@treemath.log2(4U), 2U)
  assert_eq(@treemath.log2(7U), 2U)
  assert_eq(@treemath.log2(8U), 3U)
  assert_eq(@treemath.log2(1023U), 9U)
  assert_eq(@treemath.log2(1024U), 10U)
  assert_eq(@treemath.log2(0x80000000U), 31U)
  assert_eq(@treemath.log2(0xFFFFFFFFU), 31U)
  assert_eq(@treemath.level(0U), 0U)
  assert_eq(@treemath.level(1U), 1U)
  assert_eq(@treemath.level(2U), 0U)
  assert_eq(@treemath.level(3U), 2U)
  assert_eq(@treemath.level(5U), 1U)
  assert_eq(@treemath.level(7U), 3U)
  assert_eq(@treemath.level(15U), 4U)
  assert_eq(@treemath.level(0x7FFFFFFFU), 31U)
  assert_eq(@treemath.level(0xFFFFFFFFU), 32U)
}

///|
test "common_ancestor exhaustive on n_leaves=16" {
  let n = 16U
  let w = @treemath.node_width(n)
  for x = 0U; x < w; x = x + 1U {
    assert_eq(@treemath.common_ancestor(x, x), x)
    let dp_x = @treemath.direct_path(x, n)
    let anc_x : Array[UInt32] = [x]
    for i = 0; i < dp_x.length(); i = i + 1 {
      anc_x.push(dp_x[i])
    }
    for y = 0U; y < w; y = y + 1U {
      let dp_y = @treemath.direct_path(y, n)
      let anc_y : Array[UInt32] = [y]
      for i = 0; i < dp_y.length(); i = i + 1 {
        anc_y.push(dp_y[i])
      }
      let mut expected_lca = @treemath.root(n)
      let mut found = false
      for i = 0; i < anc_x.length() && !found; i = i + 1 {
        for j = 0; j < anc_y.length(); j = j + 1 {
          if anc_x[i] == anc_y[j] {
            expected_lca = anc_x[i]
            found = true
            break
          }
        }
      }
      assert_eq(@treemath.common_ancestor(x, y), expected_lca)
    }
  }
}

///|
test "subtree_range exhaustive on n_leaves=16" {
  let n = 16U
  let w = @treemath.node_width(n)
  for x = 0U; x < w; x = x + 1U {
    let (lo, hi) = @treemath.subtree_range(x)
    assert_true(lo <= hi)
    assert_true(hi < n)
    for leaf = 0U; leaf < n; leaf = leaf + 1U {
      let leaf_node = @treemath.leaf_to_node(leaf)
      let in_subtree = @treemath.common_ancestor(leaf_node, x) == x
      let in_range = leaf >= lo && leaf <= hi
      assert_eq(in_subtree, in_range)
    }
  }
}

///|
test "zero and out-of-bounds guards" {
  assert_eq(@treemath.node_width(0U), 0U)
  assert_eq(@treemath.leaf_count(0U), 0U)
  assert_eq(@treemath.root(0U), 0U)
  assert_eq(@treemath.parent(0U, 0U), None)
  assert_eq(@treemath.sibling(0U, 0U), None)
  assert_eq(@treemath.parent(7U, 4U), None)
  assert_eq(@treemath.sibling(7U, 4U), None)
  assert_eq(@treemath.direct_path(7U, 4U), [])
  assert_eq(@treemath.copath(7U, 4U), [])
}
