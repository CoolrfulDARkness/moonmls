///|
test "RFC 9420 key-schedule.json CS3 all 5 epochs" {
  let cs = @cs.CipherSuite::from_id(3U)
  let group_id = hex_bytes("a897b53575b4dd35fed4466e4e714bfa949eaa72e616a9c68a47b39cb7a60d2e")
  let mut prev_init_secret = hex_bytes("a897b53575b4dd35fed4466e4e714bfa949eaa72e616a9c68a47b39cb7a60d2e")
  // Epoch 0
  {
    let gc : @types.GroupContext = {
      version: @types.PROTOCOL_VERSION_MLS10,
      cipher_suite: 3U,
      group_id,
      epoch: 0UL,
      tree_hash: hex_bytes("9769e302a99c457350a8e636009b12a2fee068664004606d6318eb3a1977d818"),
      confirmed_transcript_hash: hex_bytes("5e57c9364dc71f0f71b19ffe561ab77257c490708a47e29f8f73f2b318201d2f"),
      extensions: [],
    }
    let gc_bytes = gc.to_bytes()
    assert_eq(@tls.bytes_to_hex(gc_bytes), "0001000320a897b53575b4dd35fed4466e4e714bfa949eaa72e616a9c68a47b39cb7a60d2e0000000000000000209769e302a99c457350a8e636009b12a2fee068664004606d6318eb3a1977d818205e57c9364dc71f0f71b19ffe561ab77257c490708a47e29f8f73f2b318201d2f00")
    let secrets = @schedule.derive_epoch_secrets(
      cs,
      prev_init_secret,
      hex_bytes("a22606222e350fd7f0937168fe7548fb06626ab143cba7611d641693b1447509"),
      hex_bytes("e871b247379522395689182736cb3d1e7b108d6ae934b802223975de8dc3f80b"),
      gc_bytes,
    )
    assert_eq(@tls.bytes_to_hex(secrets.joiner_secret), "3e28da76edc09fb9ad59fae258839c7dc46e3c092a125499959c7413a60250b2")
    assert_eq(@tls.bytes_to_hex(secrets.welcome_secret), "b0defbdd2232224b0c0427e8efa80f011f7813291dca783433f2da1431620bbc")
    assert_eq(@tls.bytes_to_hex(secrets.init_secret), "418b197eafd925ebbf4bfd94d650aa83b1a11d6d02f33c2cc81631c6734f69d9")
    assert_eq(@tls.bytes_to_hex(secrets.sender_data_secret), "de1df3a74bbcfc7fcc631213a20c1b1842860eab8e6f0c864dcfb541cd42cf24")
    assert_eq(@tls.bytes_to_hex(secrets.encryption_secret), "ffcc3d4a757224eaf62c124f8e7def12c0db74740cf494c9f56fa7dd07214947")
    assert_eq(@tls.bytes_to_hex(secrets.exporter_secret), "27518b380b39834affecb08780ee9709627859d5f6f37994e8783791004485cb")
    assert_eq(@tls.bytes_to_hex(secrets.epoch_authenticator), "f68f6735aeeb97331d674ef4f580e11352beff543b3b6688a01a1bab97d42f26")
    assert_eq(@tls.bytes_to_hex(secrets.external_secret), "46f51f54ce4c3457ee5681925b9d1a282de166f04e28a4a316404bd14dda3138")
    assert_eq(@tls.bytes_to_hex(secrets.confirmation_key), "e8bdff522e2675c7e0582321fbeb7e61763b1f88e7ded3c57ea78c691e1d0b93")
    assert_eq(@tls.bytes_to_hex(secrets.membership_key), "6839abba79aaeb82385397612fb90cbea3bf8d427806cb3f0bfe5793c1a42fc9")
    assert_eq(@tls.bytes_to_hex(secrets.resumption_psk), "244b05004ced1a7d1dc3da6a7541e9b180b6ffe41cc6e24d63c5c9c0742b4870")
    assert_eq(@tls.bytes_to_hex(secrets.external_pub), "8206ea1eb4d8d5730a2737f7470718b9d00c2276d24a98ac4e6d7ef52cba0631")
    let exported = @schedule.mls_exporter(
      cs,
