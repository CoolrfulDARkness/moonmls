  for i = 0; i < cases.length(); i = i + 1 {
    let (raw_psks, expected_hex) = cases[i]
    let psks : Array[(@types.PreSharedKeyId, Bytes)] = []
    for j = 0; j < raw_psks.length(); j = j + 1 {
      let (id_hex, psk_hex, nonce_hex) = raw_psks[j]
      psks.push((
        @types.PreSharedKeyId::External(
          psk_id=hex_bytes(id_hex),
          psk_nonce=hex_bytes(nonce_hex),
        ),
        hex_bytes(psk_hex),
      ))
    }
    let actual = @schedule.compute_psk_secret(cs, psks)
    assert_eq(@tls.bytes_to_hex(actual), expected_hex)
  }
}

///|
test "RFC 9420 key-schedule.json CS1 all 5 epochs" {
  let cs = @cs.CipherSuite::from_id(1U)
  let group_id = hex_bytes("a897b53575b4dd35fed4466e4e714bfa949eaa72e616a9c68a47b39cb7a60d2e")
  let mut prev_init_secret = hex_bytes("a897b53575b4dd35fed4466e4e714bfa949eaa72e616a9c68a47b39cb7a60d2e")
  // Epoch 0
  {
    let gc : @types.GroupContext = {
      version: @types.PROTOCOL_VERSION_MLS10,
      cipher_suite: 1U,
      group_id,
      epoch: 0UL,
      tree_hash: hex_bytes("9769e302a99c457350a8e636009b12a2fee068664004606d6318eb3a1977d818"),
      confirmed_transcript_hash: hex_bytes("5e57c9364dc71f0f71b19ffe561ab77257c490708a47e29f8f73f2b318201d2f"),
      extensions: [],
    }
    let gc_bytes = gc.to_bytes()
    assert_eq(@tls.bytes_to_hex(gc_bytes), "0001000120a897b53575b4dd35fed4466e4e714bfa949eaa72e616a9c68a47b39cb7a60d2e0000000000000000209769e302a99c457350a8e636009b12a2fee068664004606d6318eb3a1977d818205e57c9364dc71f0f71b19ffe561ab77257c490708a47e29f8f73f2b318201d2f00")
    let secrets = @schedule.derive_epoch_secrets(
      cs,
      prev_init_secret,
      hex_bytes("a22606222e350fd7f0937168fe7548fb06626ab143cba7611d641693b1447509"),
      hex_bytes("e871b247379522395689182736cb3d1e7b108d6ae934b802223975de8dc3f80b"),
      gc_bytes,
    )
    assert_eq(@tls.bytes_to_hex(secrets.joiner_secret), "4fb996ba26b29a70f3ce6c310151ce8701cb812d027f4d4bbf5cc4e9f884638d")
    assert_eq(@tls.bytes_to_hex(secrets.welcome_secret), "ddcd9ced2d264798f876cbd00a200cdc4d77311dfef96975257efb66b0ef2c4d")
