///|
fn derive_leaf_gen_key_nonce(
  cs : @cs.CipherSuite,
  encryption_secret : Bytes,
  leaf_index : UInt,
  is_application : Bool,
  generation : UInt,
) -> (Bytes, Bytes) raise {
  // Official message-protection.json uses a 2-leaf secret tree (leaf 0 = left, leaf 1 = right).
  let branch_label = if leaf_index == 0U { b"left" } else { b"right" }
  let leaf_secret = cs.expand_with_label(
    encryption_secret,
    "tree",
    branch_label,
    cs.secret_len(),
  )
  let ratchet_label = if is_application { "application" } else { "handshake" }
  let mut secret = cs.expand_with_label(
    leaf_secret,
    ratchet_label,
    b"",
    cs.secret_len(),
  )
  let mut g = 0U
  while g < generation {
    secret = cs.derive_tree_secret(secret, "secret", g, cs.secret_len())
    g = g + 1U
  }
  let key = cs.derive_tree_secret(secret, "key", generation, cs.aead_key_len())
  let nonce = cs.derive_tree_secret(
    secret,
    "nonce",
    generation,
    cs.aead_nonce_len(),
  )
  (key, nonce)
}

///|
