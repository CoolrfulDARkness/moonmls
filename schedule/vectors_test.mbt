  ]
  for i = 0; i < cases.length(); i = i + 1 {
    let (raw_psks, expected_hex) = cases[i]
    let psks : Array[(@types.PreSharedKeyId, Bytes)] = []
    for j = 0; j < raw_psks.length(); j = j + 1 {
      let (id_hex, psk_hex, nonce_hex) = raw_psks[j]
      psks.push((
        @types.PreSharedKeyId::External(
          psk_id=hex_bytes(id_hex),
          psk_nonce=hex_bytes(nonce_hex),
        ),
        hex_bytes(psk_hex),
      ))
    }
    let actual = @schedule.compute_psk_secret(cs, psks)
    assert_eq(@tls.bytes_to_hex(actual), expected_hex)
  }
}

///|
test "RFC 9420 psk_secret.json CS3 all 11 vectors" {
  let cs = @cs.CipherSuite::from_id(3U)
  let cases : Array[(Array[(String, String, String)], String)] = [
