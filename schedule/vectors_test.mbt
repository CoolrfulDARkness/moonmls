///|
test "RFC 9420 message-protection.json CS1 full vector" {
  let cs = @cs.CipherSuite::from_id(1U)
  let group_id = hex_bytes("42e4c3a73738d838cb4f9dc550cb81406206943f9e6870ee150f2000ae8aa780")
  let epoch = 1184274UL
  let gc : @types.GroupContext = {
    version: @types.PROTOCOL_VERSION_MLS10,
    cipher_suite: 1U,
    group_id,
    epoch,
    tree_hash: hex_bytes("a257a326c7b632ce7ccdea8d3a3b5c3c2daa53a21029b3673ee05e9a3cea5934"),
    confirmed_transcript_hash: hex_bytes("59b10f7a137e853c4ef7ce43d2fe0a481bb80652f648c5efab11c3141a1ba60c"),
    extensions: [],
  }
  let sign_priv = hex_bytes("3091b9149866552f1bc8452aacd58b0a0b2ef87f2bb606d03ef6c06da0ca5cfc")
  let sign_pub = hex_bytes("62087f5b047e5292d5d29ded0977442788633c196a607988238b8c4374b4b4be")
  let encryption_secret = hex_bytes("4db33574f514024e61e2a15e71527182f62561d84b4d8230501b623d848df998")
  let sender_data_secret = hex_bytes("b21dfbbf69da2fec93299d8bd0795ad0aec22b42d83ff10a2e5e3f997672b8b3")
  let membership_key = hex_bytes("1f338b39337d019ab52c797bc836875998387e88fe711287df2258bc8f9967fb")
  let expected_proposal = @types.Proposal::from_bytes(hex_bytes("000300000002"))
  let expected_commit = @types.Commit::from_bytes(hex_bytes("404601000401205ff3e28b8183cba127d0b74459b5d8a81286c299ba02d68c7d62f6101c3782dc20e0fbf69e4e80c4b2b8d43ffac9c0863a25300d0a6880aa9287d3916c467ae3ab00"))
  let expected_application = hex_bytes("a1ab266714fdb6d121f4c7f248271fb824a3e61dd3f91835e68fc8789f17f754a86233781fb59d23811b")

  // 1. proposal_pub
  let prop_pub_raw = hex_bytes("")
  let prop_pub_msg = match @types.MlsMessage::from_bytes(prop_pub_raw).body {
    PublicMessage(m) => m
    _ => fail("expected PublicMessage for proposal_pub")
  }
  let prop_pub_ac = @schedule.unprotect_public_message(
    cs, sign_pub, Some(membership_key), prop_pub_msg, Some(gc),
  )
  assert_eq(prop_pub_ac.content.content, @types.FramedContentBody::Proposal(expected_proposal))
  let re_prop_pub = @schedule.protect_public_message(
    cs, sign_priv, Some(membership_key), prop_pub_ac.content, Some(gc), None,
  )
  assert_eq(@types.MlsMessage::public_message(re_prop_pub).to_bytes(), prop_pub_raw)

  // 2. commit_pub
  let commit_pub_raw = hex_bytes("")
  let commit_pub_msg = match @types.MlsMessage::from_bytes(commit_pub_raw).body {
    PublicMessage(m) => m
    _ => fail("expected PublicMessage for commit_pub")
  }
  let commit_pub_ac = @schedule.unprotect_public_message(
    cs, sign_pub, Some(membership_key), commit_pub_msg, Some(gc),
  )
  assert_eq(commit_pub_ac.content.content, @types.FramedContentBody::Commit(expected_commit))
  let re_commit_pub = @schedule.protect_public_message(
    cs, sign_priv, Some(membership_key), commit_pub_ac.content, Some(gc), commit_pub_ac.auth.confirmation_tag,
  )
  assert_eq(@types.MlsMessage::public_message(re_commit_pub).to_bytes(), commit_pub_raw)

  // 3. proposal_priv
  let prop_priv_raw = hex_bytes("")
  let prop_priv_msg = match @types.MlsMessage::from_bytes(prop_priv_raw).body {
    PrivateMessage(m) => m
    _ => fail("expected PrivateMessage for proposal_priv")
  }
  let prop_sd = @schedule.decrypt_sender_data(cs, sender_data_secret, prop_priv_msg)
  let (prop_k, prop_n) = derive_leaf_gen_key_nonce(cs, encryption_secret, prop_sd.leaf_index, false, prop_sd.generation)
  let prop_priv_ac = @schedule.decrypt_private_message_with_keys(
    cs, sign_pub, gc, prop_sd, prop_k, prop_n, prop_priv_msg,
  )
  assert_eq(prop_priv_ac.content.content, @types.FramedContentBody::Proposal(expected_proposal))
  let re_prop_priv = @schedule.encrypt_private_message_with_keys(
    cs, sender_data_secret, prop_sd, prop_k, prop_n, prop_priv_ac.content, prop_priv_ac.auth, 0,
  )
  let re_prop_sd = @schedule.decrypt_sender_data(cs, sender_data_secret, re_prop_priv)
  let re_prop_ac = @schedule.decrypt_private_message_with_keys(
    cs, sign_pub, gc, re_prop_sd, prop_k, prop_n, re_prop_priv,
  )
  assert_eq(re_prop_ac, prop_priv_ac)

  // 4. commit_priv
  let commit_priv_raw = hex_bytes("")
  let commit_priv_msg = match @types.MlsMessage::from_bytes(commit_priv_raw).body {
    PrivateMessage(m) => m
    _ => fail("expected PrivateMessage for commit_priv")
  }
  let commit_sd = @schedule.decrypt_sender_data(cs, sender_data_secret, commit_priv_msg)
  let (commit_k, commit_n) = derive_leaf_gen_key_nonce(cs, encryption_secret, commit_sd.leaf_index, false, commit_sd.generation)
  let commit_priv_ac = @schedule.decrypt_private_message_with_keys(
    cs, sign_pub, gc, commit_sd, commit_k, commit_n, commit_priv_msg,
  )
  assert_eq(commit_priv_ac.content.content, @types.FramedContentBody::Commit(expected_commit))

  // 5. application_priv
  let app_priv_raw = hex_bytes("")
  let app_priv_msg = match @types.MlsMessage::from_bytes(app_priv_raw).body {
    PrivateMessage(m) => m
    _ => fail("expected PrivateMessage for application_priv")
  }
  let app_sd = @schedule.decrypt_sender_data(cs, sender_data_secret, app_priv_msg)
  let (app_k, app_n) = derive_leaf_gen_key_nonce(cs, encryption_secret, app_sd.leaf_index, true, app_sd.generation)
  let app_priv_ac = @schedule.decrypt_private_message_with_keys(
    cs, sign_pub, gc, app_sd, app_k, app_n, app_priv_msg,
  )
  assert_eq(app_priv_ac.content.content, @types.FramedContentBody::Application(expected_application))
}

///|
test "RFC 9420 message-protection.json CS3 full vector" {
  let cs = @cs.CipherSuite::from_id(3U)
  let group_id = hex_bytes("fdbada2ddce02e7493673caab793308bdeb5cdb0558f151f647ab6e2ca0c63cf")
  let epoch = 1184274UL
  let gc : @types.GroupContext = {
    version: @types.PROTOCOL_VERSION_MLS10,
    cipher_suite: 3U,
    group_id,
    epoch,
    tree_hash: hex_bytes("5ae6ee5f282786b753d55f15938248f6212c69b2f677319e5fcdb2ce0bfbf48a"),
    confirmed_transcript_hash: hex_bytes("0ba35f0d36007bc44df41db074b9d98a1314e3c690cb345ceeae152fbe5b6afe"),
    extensions: [],
  }
  let sign_priv = hex_bytes("d48bc8fcb54ad6e48eb55e773577030224af3a68308cd4a2a2c3f939a774c1a0")
  let sign_pub = hex_bytes("b1d7f2e45d6c94fa8bff3b63308bbba38024c5b70c22234834ee24294b6e0a28")
  let encryption_secret = hex_bytes("ce02c4dd80a8ed57503e3a50ec11b926a549d65e840417c0635427a838b3cf29")
  let sender_data_secret = hex_bytes("85fc31fac878dbe2850e30a8fa88bdc63dacd890756aade03433791b50a510f5")
  let membership_key = hex_bytes("82f73c829938c5d1a19e19de2b2c109214455ee6671cf918af426f364162678e")
  let expected_proposal = @types.Proposal::from_bytes(hex_bytes("000300000002"))
  let expected_commit = @types.Commit::from_bytes(hex_bytes("4046010004012017e89d9ff20be622654e2b82b1e55d5b51c9e01d3b02cf0fa179c14e8697c11620d3ad3e549ffe3fe157d4d2e6627b8d35be6b5b8f37ffb10ed358bfb47c6c829500"))
  let expected_application = hex_bytes("725b6517ff1e5ed74224de23777a9b5f4a2dd74fe4a816d19ea71baa069d74c0975b7f10e61b7c3ef339")

  // 1. proposal_pub
  let prop_pub_raw = hex_bytes("")
  let prop_pub_msg = match @types.MlsMessage::from_bytes(prop_pub_raw).body {
    PublicMessage(m) => m
    _ => fail("expected PublicMessage for proposal_pub")
  }
  let prop_pub_ac = @schedule.unprotect_public_message(
    cs, sign_pub, Some(membership_key), prop_pub_msg, Some(gc),
  )
  assert_eq(prop_pub_ac.content.content, @types.FramedContentBody::Proposal(expected_proposal))
  let re_prop_pub = @schedule.protect_public_message(
    cs, sign_priv, Some(membership_key), prop_pub_ac.content, Some(gc), None,
  )
  assert_eq(@types.MlsMessage::public_message(re_prop_pub).to_bytes(), prop_pub_raw)

  // 2. commit_pub
  let commit_pub_raw = hex_bytes("")
  let commit_pub_msg = match @types.MlsMessage::from_bytes(commit_pub_raw).body {
    PublicMessage(m) => m
    _ => fail("expected PublicMessage for commit_pub")
  }
  let commit_pub_ac = @schedule.unprotect_public_message(
    cs, sign_pub, Some(membership_key), commit_pub_msg, Some(gc),
  )
  assert_eq(commit_pub_ac.content.content, @types.FramedContentBody::Commit(expected_commit))
  let re_commit_pub = @schedule.protect_public_message(
    cs, sign_priv, Some(membership_key), commit_pub_ac.content, Some(gc), commit_pub_ac.auth.confirmation_tag,
  )
  assert_eq(@types.MlsMessage::public_message(re_commit_pub).to_bytes(), commit_pub_raw)

  // 3. proposal_priv
  let prop_priv_raw = hex_bytes("")
  let prop_priv_msg = match @types.MlsMessage::from_bytes(prop_priv_raw).body {
    PrivateMessage(m) => m
    _ => fail("expected PrivateMessage for proposal_priv")
  }
  let prop_sd = @schedule.decrypt_sender_data(cs, sender_data_secret, prop_priv_msg)
  let (prop_k, prop_n) = derive_leaf_gen_key_nonce(cs, encryption_secret, prop_sd.leaf_index, false, prop_sd.generation)
  let prop_priv_ac = @schedule.decrypt_private_message_with_keys(
    cs, sign_pub, gc, prop_sd, prop_k, prop_n, prop_priv_msg,
  )
  assert_eq(prop_priv_ac.content.content, @types.FramedContentBody::Proposal(expected_proposal))
  let re_prop_priv = @schedule.encrypt_private_message_with_keys(
    cs, sender_data_secret, prop_sd, prop_k, prop_n, prop_priv_ac.content, prop_priv_ac.auth, 0,
  )
  let re_prop_sd = @schedule.decrypt_sender_data(cs, sender_data_secret, re_prop_priv)
  let re_prop_ac = @schedule.decrypt_private_message_with_keys(
    cs, sign_pub, gc, re_prop_sd, prop_k, prop_n, re_prop_priv,
  )
  assert_eq(re_prop_ac, prop_priv_ac)

  // 4. commit_priv
  let commit_priv_raw = hex_bytes("")
  let commit_priv_msg = match @types.MlsMessage::from_bytes(commit_priv_raw).body {
    PrivateMessage(m) => m
    _ => fail("expected PrivateMessage for commit_priv")
  }
  let commit_sd = @schedule.decrypt_sender_data(cs, sender_data_secret, commit_priv_msg)
  let (commit_k, commit_n) = derive_leaf_gen_key_nonce(cs, encryption_secret, commit_sd.leaf_index, false, commit_sd.generation)
  let commit_priv_ac = @schedule.decrypt_private_message_with_keys(
    cs, sign_pub, gc, commit_sd, commit_k, commit_n, commit_priv_msg,
  )
  assert_eq(commit_priv_ac.content.content, @types.FramedContentBody::Commit(expected_commit))

  // 5. application_priv
  let app_priv_raw = hex_bytes("")
  let app_priv_msg = match @types.MlsMessage::from_bytes(app_priv_raw).body {
    PrivateMessage(m) => m
    _ => fail("expected PrivateMessage for application_priv")
  }
  let app_sd = @schedule.decrypt_sender_data(cs, sender_data_secret, app_priv_msg)
  let (app_k, app_n) = derive_leaf_gen_key_nonce(cs, encryption_secret, app_sd.leaf_index, true, app_sd.generation)
  let app_priv_ac = @schedule.decrypt_private_message_with_keys(
    cs, sign_pub, gc, app_sd, app_k, app_n, app_priv_msg,
  )
  assert_eq(app_priv_ac.content.content, @types.FramedContentBody::Application(expected_application))
}
